{% block content %}
    <h1>{% if organization_type == 'Municipio' %}{{ 'invite_to_municipality' | trans }}{% else %}{{ 'invite_to_company' | trans }}{% endif %}</h1>

    <h1>Olá {{ name }}!</h1>

    <p>{% if organization_type == 'Municipio' %}Você foi convidado a participar do município {{ organization }}.{% else %}Você foi convidado a participar da organização {{ organization }}.{% endif %}</p>

    <p>Clique <a href="{{ confirmationUrl }}">aqui</a> para aceitar o convite.</p>
{% endblock %}