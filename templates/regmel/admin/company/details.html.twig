{% extends "_layouts/blank.html.twig" %}
{% set statusEnum = enum('App\\Enum\\StatusProposalEnum') %}

{% block title %}{{ 'control_panel'|trans }} - {{ 'companies'|trans }} - {{ 'details'|trans }}{% endblock %}

{% block content %}
    {% include '_components/modal-confirm-remove.html.twig' %}
    {% include 'regmel/admin/company/_partials/modal-edit.html.twig' %}
    {% include 'regmel/admin/company/_partials/modal-add-proposal-not-active.html.twig' %}

    <section class="d-flex">
        {% include "_components/side-bar.html.twig" %}

        <div class="management-content w-100 p-4">
            <div class="card card-body shadow">
                <div class="d-flex justify-content-between">
                    <h2>
                        {% if company.extraFields.tipo == 'Entidade' %}
                            OSC
                        {% else %}
                            {{ 'company'|trans }}
                        {% endif %}
                        - {{ company.name }}
                    </h2>

                    <div class="col text-end">
                        <a href="#"
                           class="btn btn-secondary edit-company"
                           data-bs-toggle="modal"
                           data-bs-target="#modalEditCompany"
                           data-id="{{ company.id }}"
                           data-token="{{ token }}">
                            {{ 'edit'|trans }}
                        </a>
                    </div>
                </div>

                <hr>

                <ul class="nav nav-tabs" id="pills-tab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <div class="d-flex align-items-center">
                            <a class="centered-icon-text nav-link active" id="pills-info-tab" data-bs-toggle="pill" href="#pills-info" role="tab" aria-controls="pills-info" aria-selected="true">
                                <i class="material-icons">description</i>
                                <span class="ms-2 font-title">Informações</span>
                            </a>
                        </div>
                    </li>
                    <li class="nav-item" role="presentation">
                        <div class="d-flex align-items-center">
                            <a class="centered-icon-text nav-link" data-cy="company-proposals" id="pills-list-tab" data-bs-toggle="pill" href="#pills-list" role="tab" aria-controls="pills-list" aria-selected="false">
                                <i class="material-icons">list</i>
                                <span class="ms-2 font-title">Propostas</span>
                            </a>
                        </div>
                    </li>
                    <li class="nav-item" role="presentation">
                        <div class="d-flex align-items-center">
                            <a class="centered-icon-text nav-link" id="pills-members-tab" data-bs-toggle="pill" href="#pills-members" role="tab" aria-controls="pills-members" aria-selected="false">
                                <i class="material-icons">groups</i>
                                <span class="ms-2 font-title">Membros</span>
                            </a>
                        </div>
                    </li>
                    {#<li class="nav-item" role="presentation">
                        <div class="d-flex align-items-center">
                            <a class="centered-icon-text nav-link" id="pills-timeline-tab" data-bs-toggle="pill" href="#pills-timeline" role="tab" aria-controls="pills-map" aria-selected="false">
                                <i class="material-icons">map</i>
                                <span class="ms-2 font-title">Linha do tempo</span>
                            </a>
                        </div>
                    </li>#}
                </ul>
                <div class="tab-content" id="pills-tabContent">
                    <div class="tab-pane fade show active" id="pills-info" role="tabpanel" aria-labelledby="pills-info-tab" tabindex="0">
                        <div class="bd-callout bd-callout-secondary">
                            <p>
                                <strong>CNPJ: </strong>{{ company.extraFields.cnpj ?? '' }}
                            </p>
                            <p>
                                <strong>Email: </strong>{{ company.extraFields.email ?? '' }}
                            </p>
                            <p>
                                <strong>Site: </strong>{{ company.extraFields.site ?? '' }}
                            </p>
                            <p>
                                <strong>Telefone: </strong>{{ company.extraFields.telefone ?? '' }}
                            </p>
                        </div>
                    </div>
                    <div class="tab-pane fade pt-3" id="pills-list" role="tabpanel" aria-labelledby="pills-list-tab" tabindex="0">
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
                        <div class="modal fade" id="modalProposalStatus" tabindex="-1" aria-labelledby="proposalStatusModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <form id="proposalStatusForm" method="post">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="proposalStatusModalLabel">Atualizar status da proposta</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <div class="mb-4">
                                                <label class="form-label fw-bold">Status *</label>
                                                <select class="form-select" name="status" required>
                                                    <option value="" selected disabled>Selecione o status</option>
                                                    <option value="{{ statusEnum.ANUIDA.value }}">{{ statusEnum.ANUIDA.value }}</option>
                                                    <option value="{{ statusEnum.NAO_ANUIDA.value }}">{{ statusEnum.NAO_ANUIDA.value }}</option>
                                                    <option value="{{ statusEnum.SELECIONADA.value }}">{{ statusEnum.SELECIONADA.value }}</option>
                                                    <option value="{{ statusEnum.SELECIONADA_DESEMPATE.value }}">{{ statusEnum.SELECIONADA_DESEMPATE.value }}</option>
                                                    <option value="{{ statusEnum.NAO_SELECIONADA.value }}">{{ statusEnum.NAO_SELECIONADA.value }}</option>
                                                    <option value="{{ statusEnum.CLASSIFICADA.value }}">{{ statusEnum.CLASSIFICADA.value }}</option>
                                                    <option value="{{ statusEnum.CLASSIFICADA_CADASTRO_RESERVA.value }}">{{ statusEnum.CLASSIFICADA_CADASTRO_RESERVA.value }}</option>
                                                    <option value="{{ statusEnum.CLASSIFICADA_NAO_SELECIONADA_EMPATE.value }}">{{ statusEnum.CLASSIFICADA_NAO_SELECIONADA_EMPATE.value }}</option>
                                                    <option value="{{ statusEnum.DESCLASSIFICADA.value }}">{{ statusEnum.DESCLASSIFICADA.value }}</option>
                                                </select>
                                                <div class="form-text">Selecione uma opção obrigatória</div>
                                            </div>

                                            <div class="mb-3">
                                                <label for="reasonText" class="form-label fw-bold">Motivo *</label>
                                                <textarea name="reason" id="reasonText" class="form-control" rows="4"
                                                          placeholder="Descreva o motivo da sua decisão..." required></textarea>
                                                <div class="form-text">Mínimo de 20 caracteres</div>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                            <button type="submit" class="btn btn-primary">Salvar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        {% endif %}

                        {% if is_granted('ROLE_COMPANY') %}
                        <div class="row">
                            <div class="col">
                                <div class="alert alert-info">
                                    <i class="material-icons">warning</i>

                                    <strong>Atenção</strong>
                                    Consulte áreas urbanas no <a href="https://interativo-mapadasperiferias.cidades.gov.br/mapa" target="_blank">Mapa das Periferias</a>
                                    <hr>
                                    Acesse aqui o <a href="{{ asset('files/Guia_do_Usuario_-_Periferia_Viva_Reformas.pdf') }}" target="_blank">Guia de Consulta</a>
                                </div>
                            </div>
                            {% if phase %}
                                <div class="col text-end">
                                    <a href="{{ path('admin_regmel_proposal_add', {
                                        id: company.id
                                    }) }}" class="btn btn-outline-primary">Nova Proposta</a>
                                </div>
                            {% else %}
                                <div class="col text-end">
                                    <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#phaseInactiveModal">
                                        Nova Proposta
                                    </button>
                                </div>
                            {% endif %}
                        </div>
                        {% endif %}

                        <table class="js-grid table table-hover table-striped mt-3">
                            <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Área de Intervenção</th>
                                <th>Municipio</th>
                                <th>Num. de Domicílios</th>
                                <th>Valor Global da Proposta</th>
                                <th>Status da Proposta</th>
                                <th>Motivo do Status</th>
                                <th>Ações</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for proposal in proposals %}
                            <tr>
                                <td>
                                    <code class="text-muted" 
                                          style="font-size: 0.85rem;"
                                          data-bs-toggle="tooltip" 
                                          data-bs-placement="top" 
                                          title="{{ proposal.id.toRfc4122() }}">
                                        {{ proposal.id.toRfc4122()|slice(0, 8) }}
                                    </code>
                                </td>
                                <td>{{ proposal.name }}</td>
                                <td>{{ proposal.extraFields.city_name ?? proposal.organizationTo.name }} </td>
                                <td>{{ proposal.extraFields.quantity_houses }}</td>
                                <td>R$ {{ (proposal.extraFields.quantity_houses * env.aurora.variables.price_per_household)|number_format(2, ',', '.') }}</td>
                                <td>
                                    {% set status = proposal.extraFields.status ?? ''  %}
                                    {% set badgeClass = ({
                                        (statusEnum.SEM_ADESAO.value): 'bg-dark text-white',
                                        (statusEnum.ENVIADA.value): 'bg-warning',
                                        (statusEnum.RECEBIDA.value): 'bg-info',
                                        (statusEnum.AGUARDANDO_AVALIACAO_ANUENCIA.value): 'bg-warning',
                                        'Aguardando Avaliação da Anuência': 'bg-warning',
                                        (statusEnum.ANUIDA.value): 'bg-success text-white',
                                        'Anuída': 'bg-success text-white',
                                        (statusEnum.NAO_ANUIDA.value): 'bg-danger text-white',
                                        'Não Anuída': 'bg-danger text-white',
                                        (statusEnum.SELECIONADA.value): 'bg-success text-white',
                                        (statusEnum.SELECIONADA_DESEMPATE.value): 'bg-success text-white',
                                        (statusEnum.NAO_SELECIONADA.value): 'bg-danger text-white',
                                        (statusEnum.CLASSIFICADA.value): 'bg-primary text-white',
                                        (statusEnum.CLASSIFICADA_CADASTRO_RESERVA.value): 'bg-primary text-white',
                                        (statusEnum.CLASSIFICADA_NAO_SELECIONADA_EMPATE.value): 'bg-primary text-white',
                                        (statusEnum.DESCLASSIFICADA.value): 'bg-danger text-white',
                                    }[status] ?? 'bg-dark') %}
                                    {% set statusDescriptions = {
                                        (statusEnum.ENVIADA.value): 'Proposta enviada pela empresa/osc e aguardando recebimento pelo município',
                                        (statusEnum.RECEBIDA.value): 'Proposta recebida pelo município e aguardando anuência',
                                        (statusEnum.SEM_ADESAO.value): 'Município ainda não possui termo de adesão aprovado',
                                        (statusEnum.AGUARDANDO_AVALIACAO_ANUENCIA.value): 'Documento de anuência enviado pelo município e aguardando validação pela SNP',
                                        (statusEnum.ANUIDA.value): 'Proposta anuída pelo município e aprovada pela SNP',
                                        'Anuída': 'Proposta anuída pelo município e aprovada pela SNP',
                                        (statusEnum.NAO_ANUIDA.value): 'Proposta não anuída pelo município',
                                        'Não Anuída': 'Proposta não anuída pelo município',
                                        (statusEnum.SELECIONADA.value): 'Proposta selecionada para execução',
                                        (statusEnum.SELECIONADA_DESEMPATE.value): 'Proposta selecionada por desempate',
                                        (statusEnum.NAO_SELECIONADA.value): 'Proposta não selecionada',
                                        (statusEnum.CLASSIFICADA.value): 'Proposta classificada',
                                        (statusEnum.CLASSIFICADA_CADASTRO_RESERVA.value): 'Proposta classificada em cadastro de reserva',
                                        (statusEnum.CLASSIFICADA_NAO_SELECIONADA_EMPATE.value): 'Proposta classificada e não selecionada por empate',
                                        (statusEnum.DESCLASSIFICADA.value): 'Proposta desclassificada'
                                    } %}
                                    {# Mapeia valores antigos para novos textos #}
                                    {% set displayStatus = status == 'Anuída' ? statusEnum.ANUIDA.value : (status == 'Não Anuída' ? statusEnum.NAO_ANUIDA.value : status) %}
                                    <span class="badge {{ badgeClass }} text-wrap" 
                                          style="max-width: 150px;" 
                                          data-bs-toggle="tooltip" 
                                          data-bs-placement="top" 
                                          title="{{ statusDescriptions[status] ?? '' }}">
                                        {{ displayStatus }}
                                    </span>
                                </td>
                                <td>
                                    {% if proposal.extraFields.status_reason is defined and proposal.extraFields.status_reason is not empty %}
                                        {{ proposal.extraFields.status_reason ?? '-' }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td style="position: relative;">
                                    <div class="dropdown">
                                        <button
                                            class="btn btn-outline-warning btn-sm dropdown-toggle"
                                            type="button"
                                            id="dropdownMenu{{ proposal.id }}"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            style="--bs-dropdown-min-width: 0; width: auto;"
                                        >
                                            {{ 'actions'|trans }}
                                        </button>
                                        <ul
                                            class="dropdown-menu dropdown-menu-end"
                                            aria-labelledby="dropdownMenu{{ proposal.id }}"
                                            style="--bs-dropdown-min-width: 0; width: auto;"
                                        >
                                            <li>
                                                <a
                                                    href="#"
                                                    class="dropdown-item"
                                                    onclick="modalProposalDetails(this)"
                                                    data-proposal='{{ {
                                                        id: proposal.id,
                                                        name: proposal.name,
                                                        created_at: proposal.createdAt|date('d/m/Y'),
                                                        created_by: proposal.createdBy.name,
                                                        company: proposal.organizationFrom.name,
                                                        area_option: env.aurora.proposals.area_characteristics[proposal.extraFields.area_characteristic] ?? '',
                                                        price_per_house: env.aurora.variables.price_per_household ?? 1,
                                                        address: proposal.extraFields.address ?? 'Não informado',
                                                        zipcode: proposal.extraFields.zipcode ?? 'Não informado',
                                                        snpr_affiliation: proposal.extraFields.snpr_affiliation ?? 'Não',
                                                        snpr_affiliation_details: proposal.extraFields.snpr_affiliation_details ?? '',
                                                        term_status: proposal.organizationTo.extraFields.term_status ?? null,
                                                        ...proposal.extraFields
                                                    }|json_encode|e('html_attr') }}'
                                                >
                                                    Ver Proposta
                                                </a>
                                            </li>

                                            {% set proposalStatus = proposal.extraFields.status ?? '' %}
                                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
                                            <li>
                                                <a
                                                    href="#"
                                                    class="dropdown-item"
                                                    onclick="openProposalStatusModal('{{ proposal.id.toRfc4122() }}', event)"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalProposalStatus"
                                                >
                                                    Atualizar Status
                                                </a>
                                            </li>
                                            {% endif %}

                                            {% if is_granted('ROLE_ADMIN') and proposalStatus in [statusEnum.ANUIDA.value, 'Anuída'] %}
                                            <li>
                                                <a
                                                    href="#"
                                                    class="dropdown-item"
                                                    onclick="openEvaluationModal('{{ proposal.id.toRfc4122() }}', '{{ proposal.organizationFrom.name|e('js') }}', event, '{{ (proposal.extraFields.state ?? '')|e('js') }}')"
                                                >
                                                    Avaliar Proposta
                                                </a>
                                            </li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="tab-pane fade pt-3" id="pills-members" role="tabpanel" aria-labelledby="pills-members-tab" tabindex="0">
                        <div class="modal fade" id="modalInvite" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Convidar agente</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form action="{{ path('admin_regmel_company_invite_agent', {id: company.id}) }}" method="post">
                                        <div class="modal-body">
                                            <div class="mb-3">
                                                <label for="name" class="mb-1">{{ 'name'|trans }}</label>
                                                <input type="text" class="form-control" id="name" name="name" data-cy="name" required>
                                            </div>
                                            <div class="mb-3">
                                                <label for="email" class="mb-1">{{ 'email'|trans }}</label>
                                                <input type="text" class="form-control" id="email" name="email" data-cy="email" required>
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                            <button type="submit" class="btn btn-primary">Convidar</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        {% if app.user.agents.first.id == createdById %}
                            <a href="" data-bs-toggle="modal" data-bs-target="#modalInvite" class="btn btn-outline-success btn-sm">Convidar</a>
                        {% endif %}

                        <table class="js-grid table table-hover table-striped mt-3">
                            <thead class="table-dark">
                            <tr>
                                <th>Nome</th>
                                {% if app.user.agents.first.id == createdById %}
                                <th> Ações </th>
                                {% endif %}
                            </tr>
                            </thead>
                            <tbody>
                            {% for agent in company.agents %}
                                <tr>
                                    <td>
                                        <a href="javascript:void(0);"
                                           class="view-member"
                                           data-info='{{ {
                                               name: agent.name,
                                               email: agent.extraFields.email ?? '',
                                               cpf: agent.extraFields.cpf ?? '',
                                               cargo: agent.extraFields.cargo ?? '',
                                               telefone: agent.extraFields.telefone ?? '',
                                               extraFields: agent.extraFields ?? {}
                                           }|json_encode|e('html_attr') }}'>
                                            {{ agent.name }}
                                        </a>
                                        {% if agent.id == createdById %}
                                            <span class="badge bg-primary ms-2">Criador</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if app.user.agents.first.id == createdById and agent.id != createdById %}
                                            <button
                                                    data-cy="remove-{{ loop.index }}"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalRemoveConfirm"
                                                    onclick="confirmRemove(this)"
                                                    data-href="{{ path(
                                                        'admin_regmel_company_remove',
                                                        {
                                                            companyId: company.id,
                                                            agentId: agent.id
                                                        }
                                                    ) }}"
                                                    class="btn btn-outline-danger btn-sm"
                                            >
                                                {{ 'delete'|trans }}
                                            </button>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    <div class="tab-pane fade pt-3" id="pills-timeline" role="tabpanel" aria-labelledby="pills-timeline-tab" tabindex="0">
                        {% include "regmel/admin/company/timeline.html.twig" %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="modal fade" id="evaluationModal" tabindex="-1" aria-labelledby="evaluationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="evaluationForm" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="evaluationModalLabel">Avaliar Proposta</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="proposalId" name="proposal_id">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Proposta: <span id="proposalName"></span></label>
                        </div>

                        <div class="mb-3">
                            <label for="result" class="form-label fw-bold">Resultado <span class="text-danger">*</span></label>
                            <select class="form-select" id="result" name="result" required onchange="toggleRankingField()">
                                <option value="" selected disabled>Selecione o resultado</option>
                                <option value="Selecionada">Selecionada</option>
                                <option value="Selecionada por desempate">Selecionada por desempate</option>
                                <option value="Classificada em cadastro de reserva">Classificada em cadastro de reserva</option>
                                <option value="Classificada e não selecionada por empate">Classificada e não selecionada por empate</option>
                                <option value="Desclassificada">Desclassificada</option>
                            </select>
                            <div class="form-text">Escolha uma opção obrigatória</div>
                        </div>

                        <div class="mb-3" id="rankingField" style="display: none;">
                            <label for="ranking" class="form-label fw-bold">Ranking (posição) <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="ranking" name="ranking" pattern="[A-Za-z0-9]+" placeholder="Ex: PA0001, DF0001, SP0010">
                            <div class="form-text">Obrigatório para propostas selecionadas e classificadas. Use letras e números.</div>
                        </div>

                        <div class="mb-3">
                            <label for="reason" class="form-label fw-bold">Motivo/Parecer <span class="text-danger">*</span></label>
                            <textarea
                                class="form-control"
                                id="reason"
                                name="reason"
                                rows="4"
                                placeholder="Descreva o motivo da sua avaliação..."
                                minlength="10"
                                required
                            ></textarea>
                            <div class="form-text">Mínimo de 10 caracteres</div>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar Avaliação</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {% include "regmel/_components/modal-proposal.html.twig" %}
{% endblock %}

{% block extra_javascripts %}
    {{ parent() }}
    <script type="module" src="{{ asset('js/modal-timeline.js') }}"></script>
    <script type="module" src="{{ asset('js/regmel/modal-member-details.js') }}"></script>
    <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
    <script type="module" src="{{ asset('js/grid-init.js') }}"></script>
    <script src="{{ asset('js/modal-proposal-details.js') }}"></script>

    <script>
        function openEvaluationModal(proposalId, proposalName, event, proposalState = '') {
            event.preventDefault();

            document.getElementById('proposalId').value = proposalId;
            document.getElementById('proposalName').textContent = proposalName;
            document.getElementById('result').value = '';
            document.getElementById('reason').value = '';
            const rankingInput = document.getElementById('ranking');
            rankingInput.value = '';
            rankingInput.dataset.state = proposalState;
            document.getElementById('rankingField').style.display = 'none';

            const modal = new bootstrap.Modal(document.getElementById('evaluationModal'));
            modal.show();
        }

        function openProposalStatusModal(proposalId, event) {
            if (event) {
                event.preventDefault();
            }

            const form = document.getElementById('proposalStatusForm');
            form.action = `/painel/admin/propostas/${proposalId}/status`;
            form.reset();
        }

        function toggleRankingField() {
            const result = document.getElementById('result').value;
            const rankingField = document.getElementById('rankingField');
            const rankingInput = document.getElementById('ranking');

            if (result.startsWith('Selecionada') || result.startsWith('Classificada')) {
                rankingField.style.display = 'block';
                rankingInput.required = true;
                if (!rankingInput.value) {
                    rankingInput.value = getNextRankingCode(rankingInput.dataset.state || '');
                }
            } else {
                rankingField.style.display = 'none';
                rankingInput.required = false;
                rankingInput.value = '';
            }
        }

        function getNextRankingCode(proposalState) {
            const state = String(proposalState || '').trim().toUpperCase();

            return /^[A-Z]{2}$/.test(state) ? `${state}0001` : '';
        }

        document.getElementById('evaluationForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const proposalId = document.getElementById('proposalId').value;
            const result = document.getElementById('result').value;
            const reason = document.getElementById('reason').value;
            const ranking = document.getElementById('ranking').value;

            try {
                const response = await fetch(`/painel/admin/avaliacoes/${proposalId}/submit`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        result: result,
                        reason: reason,
                        ranking: ranking || null
                    })
                });

                const data = await response.json();

                if (data.success) {
                    alert('✅ Proposta avaliada com sucesso!');
                    bootstrap.Modal.getInstance(document.getElementById('evaluationModal')).hide();
                    location.reload();
                } else {
                    alert('❌ Erro: ' + data.message);
                }
            } catch (error) {
                alert('❌ Erro ao avaliar: ' + error.message);
            }
        });

        // Inicializar tooltips do Bootstrap
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
{% endblock %}
