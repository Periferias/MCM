{% extends "_layouts/blank.html.twig" %}

{% set statusEnum = enum('App\\Enum\\StatusProposalEnum') %}

{% block title %}
    {{ 'control_panel'|trans }} - {{ 'proposals'|trans }}
{% endblock %}

{% block content %}
<section class="d-flex">
    {% include "_components/side-bar.html.twig" %}
    {% include "_components/modal-confirm-remove.html.twig" %}

    <div class="my-3 container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-body shadow">
                    <div class="row justify-content-between">
                        <div class="col">
                            <h2> Empresas - Propostas </h2>
                        </div>
                        <div class="col gap-1 text-end">
                            <a href="{{ path('admin_regmel_proposal_map_file_download') }}" class="btn btn-sm btn-success">
                                {{ 'export_map_file'|trans }}
                            </a>

                            <a href="{{ path('admin_regmel_proposal_project_file_download') }}" class="btn btn-sm btn-info">
                                {{ 'export_project_file'|trans }}
                            </a>

                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
                                <a href="{{ path('admin_regmel_proposal_list_download', app.request.query.all) }}" class="btn btn-sm btn-secondary">
                                    {{ 'export_csv'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <hr>

                    {% include 'regmel/_components/list-filters.html.twig' %}

                    <div class="modal fade" id="modalProposalStatus" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form id="proposalStatusForm" method="post">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Atualizar status da proposta</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Status *</label>
                                            <select class="form-select" name="status" required>
                                                <option value="" selected disabled>Selecione o status</option>
                                                <option value="{{ statusEnum.ANUIDA.value }}">{{ statusEnum.ANUIDA.value }}</option>
                                                <option value="{{ statusEnum.NAO_ANUIDA.value }}">{{ statusEnum.NAO_ANUIDA.value }}</option>
                                                <option value="{{ statusEnum.SELECIONADA.value }}">{{ statusEnum.SELECIONADA.value }}</option>
                                                <option value="{{ statusEnum.NAO_SELECIONADA.value }}">{{ statusEnum.NAO_SELECIONADA.value }}</option>
                                                <option value="{{ statusEnum.CLASSIFICADA.value }}">{{ statusEnum.CLASSIFICADA.value }}</option>
                                            </select>
                                            <div class="form-text">Selecione uma opção obrigatória</div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="reasonText" class="form-label fw-bold">Motivo *</label>
                                            <textarea name="reason" id="reasonText" class="form-control" rows="4"
                                                      placeholder="Descreva o motivo da sua decisão..." required></textarea>
                                            <div class="form-text">Mínimo de 20 caracteres</div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                        <button type="submit" class="btn btn-primary">Salvar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="modalProposalDelete" tabindex="-1" aria-labelledby="modalProposalDeleteLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form id="proposalDeleteForm" method="post">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="modalProposalDeleteLabel">Excluir Proposta</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="alert alert-warning" role="alert">
                                            <strong>Atenção!</strong> A exclusão de uma proposta não pode ser desfeita. A proposta será marcada como excluída mas permanecerá nos registros históricos.
                                        </div>

                                        <div class="mb-3">
                                            <label for="deletionReasonText" class="form-label fw-bold">Motivo da Exclusão *</label>
                                            <textarea name="deletion_reason" id="deletionReasonText" class="form-control" rows="4"
                                                      placeholder="Descreva o motivo da exclusão (mínimo 20 caracteres)..." required
                                                      minlength="20"
                                                      maxlength="1000"></textarea>
                                            <div class="form-text">Mínimo de 20 caracteres obrigatório</div>
                                            <small class="d-block mt-2">Caracteres: <span id="charCount">0</span>/1000</small>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-danger" id="deletionSubmitBtn" disabled>Excluir Proposta</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <table class="js-grid table table-hover table-striped">
                        <thead class="table-dark">
                        <tr>
                            {# A coluna Nome da Área agora é a primeira #}
                            <th>Área de Intervenção</th>
                            <th>ID</th>
                            <th>Empresa</th>
                            <th>{{ 'municipality' | trans}}</th>
                            <th>{{ 'status' | trans }}</th>
                            <th>Usuário Anuência</th>
                            <th>Qtd. Domicílios</th>
                            <th>Valor Global da Proposta</th>
                            <th>Motivo da Não Anuência</th>
                            <th>{{ 'actions' | trans }}</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for proposal in proposals %}
                            <tr>
                                {# Dado correspondente ao Nome da Área movido para o início #}
                                <td>{{ proposal.name|default('N/A') }}</td>
                                <td>{{ proposal.id }}</td>
                                <td>{{ proposal.company }}</td>
                                <td>{{ proposal.city_name }}</td>
                                <td>
                                    {% set status = proposal.status ?? '' %}
                                    {% set badgeClass = ({
                                        (statusEnum.SEM_ADESAO.value): 'bg-dark text-white',
                                        (statusEnum.ENVIADA.value): 'bg-warning',
                                        (statusEnum.RECEBIDA.value): 'bg-info',
                                        (statusEnum.AGUARDANDO_AVALIACAO_ANUENCIA.value): 'bg-warning',
                                        'Aguardando Avaliação da Anuência': 'bg-warning',
                                        (statusEnum.ANUIDA.value): 'bg-success text-white',
                                        'Anuída': 'bg-success text-white',
                                        (statusEnum.NAO_ANUIDA.value): 'bg-danger text-white',
                                        'Não Anuída': 'bg-danger text-white',
                                        (statusEnum.SELECIONADA.value): 'bg-success text-white',
                                        (statusEnum.NAO_SELECIONADA.value): 'bg-danger text-white',
                                        (statusEnum.CLASSIFICADA.value): 'bg-primary text-white',
                                    }[status] ?? 'bg-dark') %}
                                    {% set statusDescriptions = {
                                        (statusEnum.ENVIADA.value): 'Proposta enviada pela empresa/osc e aguardando recebimento pelo município',
                                        (statusEnum.RECEBIDA.value): 'Proposta recebida pelo município e aguardando anuência',
                                        (statusEnum.SEM_ADESAO.value): 'Município ainda não possui termo de adesão aprovado',
                                        (statusEnum.AGUARDANDO_AVALIACAO_ANUENCIA.value): 'Documento de anuência enviado pelo município e aguardando validação pela SNP',
                                        (statusEnum.ANUIDA.value): 'Proposta anuída pelo município e aprovada pela SNP',
                                        'Anuída': 'Proposta anuída pelo município e aprovada pela SNP',
                                        (statusEnum.NAO_ANUIDA.value): 'Proposta não anuída pelo município',
                                        'Não Anuída': 'Proposta não anuída pelo município',
                                        (statusEnum.SELECIONADA.value): 'Proposta selecionada para execução',
                                        (statusEnum.NAO_SELECIONADA.value): 'Proposta não selecionada',
                                        (statusEnum.CLASSIFICADA.value): 'Proposta classificada'
                                    } %}
                                    {# Mapeia valores antigos para novos textos #}
                                    {% set displayStatus = status == 'Anuída' ? statusEnum.ANUIDA.value : (status == 'Não Anuída' ? statusEnum.NAO_ANUIDA.value : status) %}
                                    <span class="badge {{ badgeClass }} text-wrap" 
                                          style="max-width: 150px;" 
                                          data-bs-toggle="tooltip" 
                                          data-bs-placement="top" 
                                          title="{{ statusDescriptions[status] ?? '' }}">
                                        {{ displayStatus }}
                                    </span>
                                </td>
                                <td>{{ proposal.agreement_uploaded_by_name != 'Não informado' ? proposal.agreement_uploaded_by_name : proposal.status_updated_by_name }}</td>
                                <td>{{ proposal.quantity_houses }}</td>
                                <td>R$ {{ (proposal.quantity_houses * env.aurora.variables.price_per_household)|number_format(2, ',', '.') }}</td>
                                <td>
                                    {% if status == statusEnum.NAO_ANUIDA.value or status == 'Não Anuída' %}
                                        {{ proposal.status_reason ?? proposal.agreement_reason ?? '-' }}
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td style="position: relative;">
                                    <div class="dropdown">
                                        <button
                                                class="btn btn-outline-warning btn-sm dropdown-toggle"
                                                type="button"
                                                id="dropdownMenu{{ proposal.id }}"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                style="--bs-dropdown-min-width: 0; width: auto;"
                                        >
                                            {{ 'actions'|trans }}
                                        </button>
                                        <ul
                                                class="dropdown-menu dropdown-menu-end"
                                                aria-labelledby="dropdownMenu{{ proposal.id }}"
                                                style="--bs-dropdown-min-width: 0; width: auto;"
                                        >
                                            <li>
                                                <a
                                                        href="#"
                                                        class="dropdown-item"
                                                        onclick="modalProposalDetails(this)"
                                                        data-proposal="{{ proposal|json_encode }}"
                                                >
                                                    Ver Proposta
                                                </a>
                                            </li>
                                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') %}
                                            <li>
                                                <a
                                                        href="#"
                                                        class="dropdown-item"
                                                        onclick="openProposalStatusModal('{{ proposal.id }}')"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalProposalStatus"
                                                >
                                                    Atualizar Status
                                                </a>
                                            </li>
                                            {% endif %}
                                            {% if is_granted('ROLE_ADMIN') %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <a
                                                        href="#"
                                                        class="dropdown-item text-danger"
                                                        data-cy="remove-{{ proposal.id }}"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#modalProposalDelete"
                                                        onclick="openProposalDeleteModal('{{ proposal.id }}', '{{ proposal.name }}')"
                                                >
                                                    Excluir Proposta
                                                </a>
                                            </li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center">{{ 'table.no_records_found'|trans }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

{% include "regmel/_components/modal-proposal.html.twig" %}
{% endblock %}

{% block extra_javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
    <script src="https://unpkg.com/gridjs/plugins/selection/dist/selection.umd.js"></script>
    <script type="module" src="{{ asset('js/regmel/grid-init-proposals.js') }}"></script>
    <script src="{{ asset('js/modal-proposal-details.js') }}"></script>
    <script src="{{ asset('js/modal-confirm-remove.js') }}"></script>
    <script type="module" src="{{ asset('js/load-filters.js') }}"></script>

    <script>
        function openProposalStatusModal(proposalId) {
            const form = document.getElementById('proposalStatusForm');
            form.action = `/painel/admin/propostas/${proposalId}/status`;
        }

        function openProposalDeleteModal(proposalId, proposalName) {
            const form = document.getElementById('proposalDeleteForm');
            const textarea = document.getElementById('deletionReasonText');
            const submitBtn = document.getElementById('deletionSubmitBtn');
            
            // Limpar valores anteriores
            textarea.value = '';
            submitBtn.disabled = true;
            document.getElementById('charCount').textContent = '0';
            
            // Atualizar ação do form
            form.action = `/painel/admin/propostas/${proposalId}/deletar`;
            
            // Atualizar título do modal
            document.getElementById('modalProposalDeleteLabel').textContent = `Excluir Proposta: ${proposalName}`;
        }

        // Validação em tempo real do campo de motivo de exclusão
        document.getElementById('deletionReasonText')?.addEventListener('input', function() {
            const submitBtn = document.getElementById('deletionSubmitBtn');
            const charCount = document.getElementById('charCount');
            
            charCount.textContent = this.value.length;
            
            // Habilitar botão apenas se tiver pelo menos 20 caracteres
            if (this.value.length >= 20) {
                submitBtn.disabled = false;
            } else {
                submitBtn.disabled = true;
            }
        });

        // Validar envio do formulário de exclusão
        document.getElementById('proposalDeleteForm')?.addEventListener('submit', function(e) {
            const textarea = document.getElementById('deletionReasonText');
            
            if (textarea.value.length < 20) {
                e.preventDefault();
                alert('O motivo da exclusão deve ter no mínimo 20 caracteres.');
                return false;
            }
        });

        // Inicializar tooltips do Bootstrap
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
{% endblock %}