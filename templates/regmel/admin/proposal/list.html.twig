                    <div class="modal fade" id="modalProposalStatus" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form id="proposalStatusForm" method="post">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Atualizar status da proposta</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Status *</label>
                                            <select class="form-select" name="status" required>
                                                <option value="" selected disabled>Selecione o status</option>
                                                <option value="{{ statusEnum.ANUIDA.value }}">{{ statusEnum.ANUIDA.value }}</option>
                                                <option value="{{ statusEnum.NAO_ANUIDA.value }}">{{ statusEnum.NAO_ANUIDA.value }}</option>
                                                <option value="{{ statusEnum.SELECIONADA.value }}">{{ statusEnum.SELECIONADA.value }}</option>
                                                <option value="{{ statusEnum.SELECIONADA_DESEMPATE.value }}">{{ statusEnum.SELECIONADA_DESEMPATE.value }}</option>
                                                <option value="{{ statusEnum.NAO_SELECIONADA.value }}">{{ statusEnum.NAO_SELECIONADA.value }}</option>
                                                <option value="{{ statusEnum.CLASSIFICADA.value }}">{{ statusEnum.CLASSIFICADA.value }}</option>
                                                <option value="{{ statusEnum.CLASSIFICADA_CADASTRO_RESERVA.value }}">{{ statusEnum.CLASSIFICADA_CADASTRO_RESERVA.value }}</option>
                                                <option value="{{ statusEnum.CLASSIFICADA_NAO_SELECIONADA_EMPATE.value }}">{{ statusEnum.CLASSIFICADA_NAO_SELECIONADA_EMPATE.value }}</option>
                                                <option value="{{ statusEnum.DESCLASSIFICADA.value }}">{{ statusEnum.DESCLASSIFICADA.value }}</option>
                                            </select>
                                            <div class="form-text">Selecione uma opção obrigatória</div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="reasonText" class="form-label fw-bold">Motivo *</label>
                                            <textarea name="reason" id="reasonText" class="form-control" rows="4"
                                                      placeholder="Descreva o motivo da sua decisão..." required></textarea>
                                            <div class="form-text">Mínimo de 20 caracteres</div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                        <button type="submit" class="btn btn-primary">Salvar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

