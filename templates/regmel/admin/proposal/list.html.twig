{% include "regmel/_components/modal-proposal.html.twig" %}
{% endblock %}

{% block extra_javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/gridjs/dist/gridjs.umd.js"></script>
    <script src="https://unpkg.com/gridjs/plugins/selection/dist/selection.umd.js"></script>
    <script type="module" src="{{ asset('js/regmel/grid-init-proposals.js') }}"></script>
    <script src="{{ asset('js/modal-proposal-details.js') }}"></script>
    <script src="{{ asset('js/modal-confirm-remove.js') }}"></script>
    <script type="module" src="{{ asset('js/load-filters.js') }}"></script>

    <script>
        function openProposalStatusModal(proposalId) {
            const form = document.getElementById('proposalStatusForm');
            form.action = `/painel/admin/propostas/${proposalId}/status`;
        }

        function openProposalDeleteModal(proposalId, proposalName) {
            const form = document.getElementById('proposalDeleteForm');
            const textarea = document.getElementById('deletionReasonText');
            const submitBtn = document.getElementById('deletionSubmitBtn');
            
            // Limpar valores anteriores
            textarea.value = '';
            submitBtn.disabled = true;
            document.getElementById('charCount').textContent = '0';
            
            // Atualizar ação do form
            form.action = `/painel/admin/propostas/${proposalId}/deletar`;
            
            // Atualizar título do modal
            document.getElementById('modalProposalDeleteLabel').textContent = `Excluir Proposta: ${proposalName}`;
        }

        // Validação em tempo real do campo de motivo de exclusão
        document.getElementById('deletionReasonText')?.addEventListener('input', function() {
            const submitBtn = document.getElementById('deletionSubmitBtn');
            const charCount = document.getElementById('charCount');
            
            charCount.textContent = this.value.length;
            
            // Habilitar botão apenas se tiver pelo menos 20 caracteres
            if (this.value.length >= 20) {
                submitBtn.disabled = false;
            } else {
                submitBtn.disabled = true;
            }
        });

        // Validar envio do formulário de exclusão
        document.getElementById('proposalDeleteForm')?.addEventListener('submit', function(e) {
            const textarea = document.getElementById('deletionReasonText');
            
            if (textarea.value.length < 20) {
                e.preventDefault();
                alert('O motivo da exclusão deve ter no mínimo 20 caracteres.');
                return false;
            }
        });

        // Função para exportar dados filtrados por status em XLS
        function exportTabaComStatus(status) {
            const params = new URLSearchParams();
            params.append('status', status);
            
            // Redirecionar para a rota de download com o filtro de status
            window.location.href = '{{ path('admin_regmel_proposal_list_download') }}?' + params.toString();
        }

        // Inicializar tooltips do Bootstrap
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Contar registros por status e atualizar abas (apenas dentro de cada tab)
            const selecionadaCount = document.querySelectorAll('#panel-selecionada .proposal-row').length;
            const classificadaCount = document.querySelectorAll('#panel-classificada .proposal-row').length;
            const naoSelecionadaCount = document.querySelectorAll('#panel-nao-selecionada .proposal-row').length;
            const totalCount = document.querySelectorAll('#panel-all .proposal-row').length;

            // Atualizar labels das abas
            const tabAll = document.getElementById('tab-all');
            const tabSelecionada = document.getElementById('tab-selecionada');
            const tabClassificada = document.getElementById('tab-classificada');
            const tabNaoSelecionada = document.getElementById('tab-nao-selecionada');

            if (tabAll) {
                tabAll.innerHTML = '<i class="bi bi-list"></i> Todas as Propostas <span class="badge bg-secondary ms-2">' + totalCount + '</span>';
            }
            if (tabSelecionada) {
                tabSelecionada.innerHTML = '<i class="bi bi-check-circle"></i> Selecionadas <span class="badge bg-success ms-2">' + selecionadaCount + '</span>';
            }
            if (tabClassificada) {
                tabClassificada.innerHTML = '<i class="bi bi-folder-check"></i> Classificadas <span class="badge bg-info ms-2">' + classificadaCount + '</span>';
            }
            if (tabNaoSelecionada) {
                tabNaoSelecionada.innerHTML = '<i class="bi bi-x-circle"></i> Não Selecionadas <span class="badge bg-danger ms-2">' + naoSelecionadaCount + '</span>';
            }

            // Inicializar drag-and-drop apenas para ROLE_ADMIN
            const isAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
            if (isAdmin) {
                setupDragAndDrop('tableSelecionada');
                setupDragAndDrop('tableClassificada');
            }
        });

        const autoSaveTimeouts = {};

        function setupDragAndDrop(tableId) {
            const tbody = document.querySelector(`#${tableId} tbody`);
            if (!tbody) return;

            let draggedItem = null;

            tbody.addEventListener('dragstart', e => {
                const row = e.target.closest('.proposal-row');
                if (row) {
                    draggedItem = row;
                    draggedItem.style.opacity = '0.5';
                }
            });

            tbody.addEventListener('dragend', e => {
                if (draggedItem) draggedItem.style.opacity = '1';
                draggedItem = null;
            });

            tbody.addEventListener('dragover', e => {
                e.preventDefault();
                if (!draggedItem) return;
                const afterElement = getDragAfterElement(tbody, e.clientY);
                if (afterElement) {
                    tbody.insertBefore(draggedItem, afterElement);
                } else {
                    tbody.appendChild(draggedItem);
                }
                updatePositionNumbers(tableId);
                scheduleAutoSave(tableId);
            });

            // Salvar ao mudar input de posição
            tbody.querySelectorAll('input[type="number"]').forEach(input => {
                input.addEventListener('change', () => {
                    scheduleAutoSave(tableId);
                });
            });
        }

        function getDragAfterElement(container, y) {
            const items = [...container.querySelectorAll('.proposal-row:not(.dragging)')];
            return items.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset, element: child };
                }
                return closest;
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        function updatePositionNumbers(tableId) {
            document.querySelectorAll(`#${tableId} .proposal-row`).forEach((row, i) => {
                const input = row.querySelector('input[type="number"]');
                if (input) input.value = i + 1;
            });
        }

        function scheduleAutoSave(tableId) {
            clearTimeout(autoSaveTimeouts[tableId]);
            autoSaveTimeouts[tableId] = setTimeout(() => autoSave(tableId), 1000);
        }

        async function autoSave(tableId) {
            const rows = document.querySelectorAll(`#${tableId} .proposal-row`);
            const reordering = [];

            rows.forEach((row, index) => {
                const proposalId = row.getAttribute('data-proposal-id');
                const input = row.querySelector('input[type="number"]');
                const newOrder = input.value ? parseInt(input.value) : index + 1;
                reordering.push({ proposalId, newOrder });
            });

            try {
                const response = await fetch('/api/proposals/reorder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reordering })
                });

                if (!response.ok) {
                    console.error('Erro ao salvar ordem:', await response.text());
                }
            } catch (error) {
                console.error('Erro na requisição:', error);
            }
        }
    </script>
{% endblock %}