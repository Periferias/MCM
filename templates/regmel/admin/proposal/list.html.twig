        // Função para exportar dados filtrados por status em XLS
        function exportTabaComStatus(status) {
            const params = new URLSearchParams();
            if (status === 'selecionadas' || status === 'classificadas' || status === 'nao_selecionadas') {
                params.append('status_group', status);
            } else {
