            }
            
            // Redirecionar para a rota de download com o filtro de status
            window.location.href = '{{ path('admin_regmel_proposal_list_download') }}?' + params.toString();
        }

        function initializeProposalTabSorting() {
            const tables = document.querySelectorAll('#proposalTabsContent table.proposal-sort-table');

            tables.forEach((table) => {
                const headers = table.querySelectorAll('thead th');

                headers.forEach((header, columnIndex) => {
                    if (header.dataset.sortable === 'false') {
                        return;
                    }

                    header.dataset.sortable = 'true';

                    header.addEventListener('click', () => {
                        const tbody = table.querySelector('tbody');
                        if (!tbody) {
                            return;
                        }

                        const rows = Array.from(tbody.querySelectorAll('tr'))
                            .filter((row) => !row.querySelector(`td[colspan]`));

                        if (rows.length === 0) {
                            return;
                        }

                        const nextDirection = header.dataset.sortDirection === 'asc' ? 'desc' : 'asc';

                        headers.forEach((th) => {
                            th.classList.remove('sort-asc', 'sort-desc');
                            th.dataset.sortDirection = '';
                        });

                        header.dataset.sortDirection = nextDirection;
                        header.classList.add(nextDirection === 'asc' ? 'sort-asc' : 'sort-desc');

                        rows.sort((rowA, rowB) => {
                            const valueA = getSortableCellValue(rowA, columnIndex);
                            const valueB = getSortableCellValue(rowB, columnIndex);
                            return compareSortableValues(valueA, valueB, nextDirection);
                        });

                        rows.forEach((row) => tbody.appendChild(row));
                    });
                });
            });
        }

        function getSortableCellValue(row, columnIndex) {
            const cell = row.children[columnIndex];
            if (!cell) {
                return '';
            }

            const input = cell.querySelector('input, select, textarea');
            if (input) {
                return input.value.trim();
            }

            return cell.textContent.replace(/\s+/g, ' ').trim();
        }

        function compareSortableValues(rawValueA, rawValueB, direction) {
            const valueA = normalizeSortableValue(rawValueA);
            const valueB = normalizeSortableValue(rawValueB);

            let result = 0;

            if (valueA.type === valueB.type && (valueA.type === 'number' || valueA.type === 'date')) {
                result = valueA.value - valueB.value;
            } else {
                result = String(valueA.value).localeCompare(String(valueB.value), 'pt-BR', {
                    numeric: true,
                    sensitivity: 'base'
                });
            }

            return direction === 'asc' ? result : -result;
        }

        function normalizeSortableValue(value) {
            const normalized = String(value ?? '').trim();

            if (normalized === '' || normalized === '-') {
                return { type: 'text', value: '' };
            }

            const currencyValue = normalized
                .replace(/\s/g, '')
                .replace(/^R\$/, '')
                .replace(/\./g, '')
                .replace(',', '.');

            if (/^-?\d+(\.\d+)?$/.test(currencyValue)) {
                return { type: 'number', value: Number(currencyValue) };
            }

            const dateMatch = normalized.match(/^(\d{2})\/(\d{2})\/(\d{4})(?:\s+(\d{2}):(\d{2}))?$/);
            if (dateMatch) {
                const [, day, month, year, hour = '00', minute = '00'] = dateMatch;
                const dateValue = new Date(`${year}-${month}-${day}T${hour}:${minute}:00`).getTime();

                if (!Number.isNaN(dateValue)) {
                    return { type: 'date', value: dateValue };
                }
            }

            const isoDateValue = Date.parse(normalized);
            if (!Number.isNaN(isoDateValue) && /[-/:]/.test(normalized)) {
                return { type: 'date', value: isoDateValue };
            }

            return { type: 'text', value: normalized.toLowerCase() };
        }

        // Inicializar tooltips do Bootstrap
        document.addEventListener('DOMContentLoaded', function() {
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            initializeProposalTabSorting();

            // Contar registros por status e atualizar abas (apenas dentro de cada tab)
            const selecionadaCount = document.querySelectorAll('#panel-selecionada .proposal-row').length;
            const classificadaCount = document.querySelectorAll('#panel-classificada .proposal-row').length;
            const naoSelecionadaCount = document.querySelectorAll('#panel-nao-selecionada .proposal-row').length;
            const anuídaCount = document.querySelectorAll('#panel-anuida .proposal-row').length;
            const totalCount = document.querySelectorAll('#panel-all .proposal-row').length;

            // Atualizar labels das abas
            const tabAll = document.getElementById('tab-all');
            const tabAnuida = document.getElementById('tab-anuida');
            const tabSelecionada = document.getElementById('tab-selecionada');
            const tabClassificada = document.getElementById('tab-classificada');
            const tabNaoSelecionada = document.getElementById('tab-nao-selecionada');

            if (tabAll) {
                tabAll.innerHTML = '<i class="bi bi-list"></i> Todas as Propostas <span class="badge bg-secondary ms-2">' + totalCount + '</span>';
            }
            if (tabAnuida) {
                tabAnuida.innerHTML = '<i class="bi bi-check2-circle"></i> Anuídas <span class="badge bg-success ms-2" style="background-color: #155724 !important;">' + anuídaCount + '</span>';
            }
            if (tabSelecionada) {
                tabSelecionada.innerHTML = '<i class="bi bi-check-circle"></i> Selecionadas <span class="badge bg-success ms-2">' + selecionadaCount + '</span>';
            }
            if (tabClassificada) {
                tabClassificada.innerHTML = '<i class="bi bi-folder-check"></i> Classificadas <span class="badge bg-info ms-2">' + classificadaCount + '</span>';
            }
            if (tabNaoSelecionada) {
                tabNaoSelecionada.innerHTML = '<i class="bi bi-x-circle"></i> Não Selecionadas <span class="badge bg-danger ms-2">' + naoSelecionadaCount + '</span>';
            }

            const isAdmin = {{ is_granted('ROLE_ADMIN') ? 'true' : 'false' }};
            if (isAdmin) {
                setupDragAndDrop('tableSelecionada');
                setupDragAndDrop('tableClassificada');
                setupPositionEditing('tableSelecionada');
                setupPositionEditing('tableClassificada');
            }
        });

        let reorderState = {
            tableId: null,
            originalRows: [],
            reordering: []
        };

        let rankingEditState = null;

        function setupDragAndDrop(tableId) {
            const tbody = document.querySelector(`#${tableId} tbody`);
            if (!tbody) return;

            let draggedItem = null;

            tbody.addEventListener('dragstart', e => {
                const row = e.target.closest('.proposal-row');
                if (row) {
                    reorderState.originalRows = getTableSnapshot(tableId);
                    reorderState.tableId = tableId;
                    draggedItem = row;
                    draggedItem.style.opacity = '0.5';
                    draggedItem.classList.add('dragging');
                }
            });

            tbody.addEventListener('dragend', e => {
                if (draggedItem) {
                    draggedItem.style.opacity = '1';
                    draggedItem.classList.remove('dragging');
                }

                if (reorderState.tableId === tableId && hasOrderChanged(tableId, reorderState.originalRows)) {
                    updatePositionNumbers(tableId);
                    reorderState.reordering = collectReordering(tableId);
                    openReorderConfirmationModal();
                } else {
                    resetReorderState();
                }

                draggedItem = null;
            });

            tbody.addEventListener('dragover', e => {
                e.preventDefault();
                if (!draggedItem) return;
                const afterElement = getDragAfterElement(tbody, e.clientY);
                if (afterElement) {
                    tbody.insertBefore(draggedItem, afterElement);
                } else {
                    tbody.appendChild(draggedItem);
                }
                updatePositionNumbers(tableId);
            });
        }

        function getDragAfterElement(container, y) {
            const items = [...container.querySelectorAll('.proposal-row:not(.dragging)')];
            return items.reduce((closest, child) => {
                const box = child.getBoundingClientRect();
                const offset = y - box.top - box.height / 2;
                if (offset < 0 && offset > closest.offset) {
                    return { offset, element: child };
                }
                return closest;
            }, { offset: Number.NEGATIVE_INFINITY }).element;
        }

        function updatePositionNumbers(tableId) {
            const stateCounters = {};
            document.querySelectorAll(`#${tableId} .proposal-row`).forEach((row, i) => {
                const input = row.querySelector('input.position-input-sel, input.position-input-class');
                const state = String(row.dataset.state || '').trim().toUpperCase();
                if (!input || !/^[A-Z]{2}$/.test(state)) {
                    return;
                }

                stateCounters[state] = (stateCounters[state] || 0) + 1;
                input.value = `${state}${String(stateCounters[state]).padStart(4, '0')}`;
            });
        }

        function setupPositionEditing(tableId) {
            const table = document.getElementById(tableId);
            if (!table) return;

            table.querySelectorAll('input.position-input-sel, input.position-input-class').forEach((input) => {
                input.dataset.originalValue = input.value;

                input.addEventListener('focus', () => selectPositionNumericPart(input));
                input.addEventListener('click', () => selectPositionNumericPart(input));
                input.addEventListener('mousedown', (event) => event.stopPropagation());
                input.addEventListener('dragstart', (event) => event.stopPropagation());
                input.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') {
                        event.preventDefault();
                        input.blur();
                    }
                });
                input.addEventListener('input', () => normalizePositionInput(input));
                input.addEventListener('change', () => applyPositionInputEdit(input));
                input.addEventListener('blur', () => applyPositionInputEdit(input));
            });
        }

        function selectPositionNumericPart(input) {
            const state = getPositionInputState(input);
            window.setTimeout(() => {
                input.setSelectionRange(state.length, input.value.length);
            }, 0);
        }

        function getPositionInputState(input) {
            const rowState = input.closest('.proposal-row')?.dataset.state || '';
            const inputState = String(input.value || '').match(/^[A-Z]{2}/)?.[0] || '';

            return String(rowState || inputState).trim().toUpperCase();
        }

        function normalizePositionInput(input) {
            const state = getPositionInputState(input);
            const numericPart = String(input.value || '').replace(/\D/g, '').slice(0, 4);

            input.value = `${state}${numericPart}`;
        }

        function applyPositionInputEdit(input) {
            if (
                input.dataset.applyingPositionEdit === 'true' ||
                (reorderState.tableId && reorderState.reordering.length > 0) ||
                rankingEditState
            ) {
                return;
            }

            const row = input.closest('.proposal-row');
            const table = input.closest('table');
            const tableId = table?.id;
            const state = getPositionInputState(input);
            const originalValue = input.dataset.originalValue || row?.dataset.currentOrder || '';
            const numericPart = String(input.value || '').replace(/\D/g, '');

            if (!row || !tableId || !/^[A-Z]{2}$/.test(state) || !numericPart) {
                input.value = originalValue;
                return;
            }

            const requestedPosition = Math.max(1, Number.parseInt(numericPart, 10));
            const normalizedValue = `${state}${String(requestedPosition).padStart(4, '0')}`;

            if (normalizedValue === originalValue) {
                input.value = originalValue;
                return;
            }

            input.dataset.applyingPositionEdit = 'true';
            input.value = normalizedValue;
            rankingEditState = {
                input,
                row,
                tableId,
                proposalId: row.getAttribute('data-proposal-id'),
                originalValue,
                newValue: normalizedValue
            };
            input.dataset.applyingPositionEdit = 'false';

            openRankingEditConfirmationModal();
        }

        // Função para abrir modal de avaliar proposta (igual a página de avaliações)
        function openEvaluationModal(proposalId, proposalName, event, proposalState = '') {
            event.preventDefault();
            
            document.getElementById('proposalId').value = proposalId;
            document.getElementById('proposalName').textContent = proposalName;
            document.getElementById('result').value = '';
            document.getElementById('reason').value = '';
            document.getElementById('notes').value = '';
            const rankingInput = document.getElementById('ranking');
            rankingInput.value = '';
            rankingInput.dataset.state = proposalState;
            document.getElementById('rankingField').style.display = 'none';
            
            const modal = new bootstrap.Modal(document.getElementById('evaluationModal'));
            modal.show();
        }

        function toggleRankingField() {
            const result = document.getElementById('result').value;
            const rankingField = document.getElementById('rankingField');
            const rankingInput = document.getElementById('ranking');
            
            if (result.startsWith('Selecionada') || result.startsWith('Classificada')) {
                rankingField.style.display = 'block';
                rankingInput.required = true;
                if (!rankingInput.value) {
                    rankingInput.value = getNextRankingCode(result, rankingInput.dataset.state || '');
                }
            } else {
                rankingField.style.display = 'none';
                rankingInput.required = false;
                rankingInput.value = '';
            }
        }

        function collectReordering(tableId) {
            const rows = document.querySelectorAll(`#${tableId} .proposal-row`);
            const reordering = [];

            rows.forEach((row, index) => {
                const proposalId = row.getAttribute('data-proposal-id');
                reordering.push({ proposalId, newOrder: index + 1 });
            });

            return reordering;
        }

        function getTableSnapshot(tableId) {
            return Array.from(document.querySelectorAll(`#${tableId} .proposal-row`)).map((row) => ({
                proposalId: row.getAttribute('data-proposal-id'),
                order: row.getAttribute('data-current-order') || ''
            }));
        }

        function hasOrderChanged(tableId, originalRows) {
            const currentRows = Array.from(document.querySelectorAll(`#${tableId} .proposal-row`)).map((row, index) => ({
                proposalId: row.getAttribute('data-proposal-id'),
                order: String(index + 1)
            }));

            if (currentRows.length !== originalRows.length) {
                return true;
            }

            return currentRows.some((row, index) => row.proposalId !== originalRows[index]?.proposalId);
        }

        function restoreOriginalOrder(tableId, snapshot) {
            const tbody = document.querySelector(`#${tableId} tbody`);
            if (!tbody || !snapshot.length) {
                return;
            }

            snapshot.forEach((item) => {
                const row = tbody.querySelector(`[data-proposal-id="${item.proposalId}"]`);
                if (row) {
                    tbody.appendChild(row);
                    row.setAttribute('data-current-order', item.order);
                    const input = row.querySelector('input.position-input-sel, input.position-input-class');
                    if (input) {
                        input.value = item.order;
                        input.dataset.originalValue = item.order;
                    }
                }
            });
        }

        function openReorderConfirmationModal() {
            const modalEl = document.getElementById('confirmReorderModal');
            if (!modalEl) {
                return;
            }

            setConfirmationModalMessage('Deseja salvar a nova ordem das propostas?');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            modalEl.addEventListener('hidden.bs.modal', handleReorderCancel, { once: true });
        }

        function openRankingEditConfirmationModal() {
            const modalEl = document.getElementById('confirmReorderModal');
            if (!modalEl) {
                return;
            }

            setConfirmationModalMessage('Deseja salvar a nova posição da proposta?');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();

            modalEl.addEventListener('hidden.bs.modal', handleRankingEditCancel, { once: true });
        }

        function setConfirmationModalMessage(message) {
            const modalBody = document.querySelector('#confirmReorderModal .modal-body');
            if (modalBody) {
                modalBody.textContent = message;
            }
        }

        function handleReorderCancel() {
            if (!reorderState.tableId || reorderState.reordering.length === 0) {
                return;
            }

            restoreOriginalOrder(reorderState.tableId, reorderState.originalRows);
            resetReorderState();
        }

        function handleRankingEditCancel() {
            if (!rankingEditState) {
                return;
            }

            rankingEditState.input.value = rankingEditState.originalValue;
            rankingEditState.input.dataset.originalValue = rankingEditState.originalValue;
            rankingEditState = null;
        }

        function resetReorderState() {
            reorderState = {
                tableId: null,
                originalRows: [],
                reordering: []
            };
        }

        async function saveConfirmedReordering() {
            const { tableId, reordering } = reorderState;
            if (!tableId || reordering.length === 0) {
                return;
            }

            try {
                const response = await fetch('/painel/admin/propostas/reorder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reordering })
                });

                if (!response.ok) {
                    console.error('Erro ao salvar ordem:', await response.text());
                    restoreOriginalOrder(tableId, reorderState.originalRows);
                } else {
                    reordering.forEach((item) => {
                        const row = document.querySelector(`#${tableId} [data-proposal-id="${item.proposalId}"]`);
                        if (row) {
                            const input = row.querySelector('input.position-input-sel, input.position-input-class');
                            row.setAttribute('data-current-order', input ? input.value : String(item.newOrder));
                            if (input) {
                                input.dataset.originalValue = input.value;
                            }
                        }
                    });
                }
            } catch (error) {
                console.error('Erro na requisição:', error);
                restoreOriginalOrder(tableId, reorderState.originalRows);
            } finally {
                resetReorderState();
            }
        }

        async function saveConfirmedRankingEdit() {
            if (!rankingEditState) {
                return;
            }

            const { input, row, proposalId, originalValue, newValue } = rankingEditState;

            try {
                const response = await fetch(`/painel/admin/propostas/${proposalId}/ranking`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ranking: newValue })
                });

                if (!response.ok) {
                    const data = await response.json().catch(() => null);
                    input.value = originalValue;
                    input.dataset.originalValue = originalValue;
                    row.setAttribute('data-current-order', originalValue);
                    alert(data?.message || 'Não foi possível atualizar a posição.');
                    return;
                }

                const data = await response.json().catch(() => null);
                const savedRanking = data?.ranking || newValue;
                input.value = savedRanking;
                input.dataset.originalValue = savedRanking;
                row.setAttribute('data-current-order', savedRanking);
            } catch (error) {
                console.error('Erro na requisição:', error);
                input.value = originalValue;
                input.dataset.originalValue = originalValue;
                row.setAttribute('data-current-order', originalValue);
                alert('Erro ao atualizar a posição.');
            } finally {
                rankingEditState = null;
            }
        }

        document.getElementById('confirmReorderButton')?.addEventListener('click', async () => {
            const modalEl = document.getElementById('confirmReorderModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalEl.removeEventListener('hidden.bs.modal', handleReorderCancel);
            modalEl.removeEventListener('hidden.bs.modal', handleRankingEditCancel);
            modal.hide();

            if (rankingEditState) {
                await saveConfirmedRankingEdit();
            } else {
                await saveConfirmedReordering();
            }
        });
    </script>
{% endblock %}
