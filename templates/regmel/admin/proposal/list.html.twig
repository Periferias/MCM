{% extends "_layouts/blank.html.twig" %}

{% set statusEnum = enum('App\\Enum\\StatusProposalEnum') %}
{% set selectedStatusValues = [
    statusEnum.SELECIONADA.value,
    statusEnum.SELECIONADA_DESEMPATE.value,
] %}
{% set classifiedStatusValues = [
    statusEnum.CLASSIFICADA.value,
    statusEnum.CLASSIFICADA_CADASTRO_RESERVA.value,
    statusEnum.CLASSIFICADA_NAO_SELECIONADA_EMPATE.value,
] %}
{% set nonSelectedStatusValues = [
    statusEnum.NAO_SELECIONADA.value,
    statusEnum.DESCLASSIFICADA.value,
] %}

{% block title %}
    {{ 'control_panel'|trans }} - {{ 'proposals'|trans }}
{% endblock %}

{% block content %}
<section class="d-flex">
    {% include "_components/side-bar.html.twig" %}
    {% include "_components/modal-confirm-remove.html.twig" %}

    <div class="my-3 container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-body shadow">
                    <div class="row justify-content-between">
                        <div class="col">
                            <h2> Empresas - Propostas </h2>
                        </div>
                        <div class="col gap-1 text-end">
                            <a href="{{ path('admin_regmel_proposal_map_file_download') }}" class="btn btn-sm btn-success">
                                {{ 'export_map_file'|trans }}
                            </a>

                            <a href="{{ path('admin_regmel_proposal_project_file_download') }}" class="btn btn-sm btn-info">
                                {{ 'export_project_file'|trans }}
                            </a>

                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') or is_granted('ROLE_CAIXA') %}
                                <a href="{{ path('admin_regmel_proposal_list_download', app.request.query.all) }}" class="btn btn-sm btn-secondary">
                                    {{ 'export_csv'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <hr>

