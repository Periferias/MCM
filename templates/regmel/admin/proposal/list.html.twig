{% extends "_layouts/blank.html.twig" %}

{% set statusEnum = enum('App\\Enum\\StatusProposalEnum') %}

{% block title %}
    {{ 'control_panel'|trans }} - {{ 'proposals'|trans }}
{% endblock %}

{% block content %}
<section class="d-flex">
    {% include "_components/side-bar.html.twig" %}
    {% include "_components/modal-confirm-remove.html.twig" %}

    <div class="my-3 container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-body shadow">
                    <div class="row justify-content-between">
                        <div class="col">
                            <h2> Empresas - Propostas </h2>
                        </div>
                        <div class="col gap-1 text-end">
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_evaluation_list') }}" class="btn btn-sm btn-warning">
                                    <i class="bi bi-check-circle"></i> Avaliar Propostas Anuídas
                                </a>
                            {% endif %}

                            <a href="{{ path('admin_regmel_proposal_map_file_download') }}" class="btn btn-sm btn-success">
                                {{ 'export_map_file'|trans }}
                            </a>

                            <a href="{{ path('admin_regmel_proposal_project_file_download') }}" class="btn btn-sm btn-info">
                                {{ 'export_project_file'|trans }}
                            </a>

                            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MANAGER') or is_granted('ROLE_CAIXA') %}
                                <a href="{{ path('admin_regmel_proposal_list_download', app.request.query.all) }}" class="btn btn-sm btn-secondary">
                                    {{ 'export_csv'|trans }}
                                </a>
                            {% endif %}
                        </div>
                    </div>

                    <hr>

                    {% include 'regmel/_components/list-filters.html.twig' %}

                    {# Abas para filtrar propostas por status #}
                    <style>
                        #proposalTabs .badge {
                            display: inline-flex !important;
                            align-items: center !important;
                            justify-content: center !important;
                            min-width: 22px;
                            height: 22px;
                        }
                        /* Estilos para container com scroll horizontal */
                        .table-scroll-container {
                            overflow-x: auto;
                            border: 1px solid #dee2e6;
                            border-radius: 4px;
                            max-height: 100%;
                        }
                        /* Barra de rolagem estilizada para Chrome, Edge e Safari */
                        .table-scroll-container::-webkit-scrollbar {
                            height: 8px;
                        }
                        .table-scroll-container::-webkit-scrollbar-track {
                            background: #f1f1f1;
                        }
                        .table-scroll-container::-webkit-scrollbar-thumb {
                            background: #888;
                            border-radius: 4px;
                        }
                        .table-scroll-container::-webkit-scrollbar-thumb:hover {
                            background: #555;
                        }
                        /* Firefox */
                        .table-scroll-container {
                            scrollbar-width: thin;
                            scrollbar-color: #888 #f1f1f1;
                        }
                    </style>
                    <div class="mt-4 mb-3">
                        <ul class="nav nav-tabs" id="proposalTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active" id="tab-all" data-bs-toggle="tab" data-bs-target="#panel-all" type="button" role="tab" aria-controls="panel-all" aria-selected="true">
                                    <i class="bi bi-list"></i> Todas as Propostas
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-anuida" data-bs-toggle="tab" data-bs-target="#panel-anuida" type="button" role="tab" aria-controls="panel-anuida" aria-selected="false">
                                    <i class="bi bi-check2-circle"></i> Anuídas
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-selecionada" data-bs-toggle="tab" data-bs-target="#panel-selecionada" type="button" role="tab" aria-controls="panel-selecionada" aria-selected="false">
                                    <i class="bi bi-check-circle"></i> Selecionadas
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-classificada" data-bs-toggle="tab" data-bs-target="#panel-classificada" type="button" role="tab" aria-controls="panel-classificada" aria-selected="false">
                                    <i class="bi bi-folder-check"></i> Classificadas
                                </button>
                            </li>
                            {% if 'ROLE_CAIXA' not in app.user.roles %}
                            <li class="nav-item" role="presentation">
                                <button class="nav-link" id="tab-nao-selecionada" data-bs-toggle="tab" data-bs-target="#panel-nao-selecionada" type="button" role="tab" aria-controls="panel-nao-selecionada" aria-selected="false">
                                    <i class="bi bi-x-circle"></i> Não Selecionadas
                                </button>
                            </li>
                            {% endif %}
                        </ul>
                    </div>

                    <div class="modal fade" id="modalProposalStatus" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form id="proposalStatusForm" method="post">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="exampleModalLabel">Atualizar status da proposta</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Status *</label>
                                            <select class="form-select" name="status" required>
                                                <option value="" selected disabled>Selecione o status</option>
                                                <option value="{{ statusEnum.ANUIDA.value }}">{{ statusEnum.ANUIDA.value }}</option>
                                                <option value="{{ statusEnum.NAO_ANUIDA.value }}">{{ statusEnum.NAO_ANUIDA.value }}</option>
                                                <option value="{{ statusEnum.SELECIONADA.value }}">{{ statusEnum.SELECIONADA.value }}</option>
                                                <option value="{{ statusEnum.NAO_SELECIONADA.value }}">{{ statusEnum.NAO_SELECIONADA.value }}</option>
                                                <option value="{{ statusEnum.CLASSIFICADA.value }}">{{ statusEnum.CLASSIFICADA.value }}</option>
                                            </select>
                                            <div class="form-text">Selecione uma opção obrigatória</div>
                                        </div>

                                        <div class="mb-3">
                                            <label for="reasonText" class="form-label fw-bold">Motivo *</label>
                                            <textarea name="reason" id="reasonText" class="form-control" rows="4"
                                                      placeholder="Descreva o motivo da sua decisão..." required></textarea>
                                            <div class="form-text">Mínimo de 20 caracteres</div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
                                        <button type="submit" class="btn btn-primary">Salvar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="modalProposalDelete" tabindex="-1" aria-labelledby="modalProposalDeleteLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form id="proposalDeleteForm" method="post">
                                    <div class="modal-header">
                                        <h1 class="modal-title fs-5" id="modalProposalDeleteLabel">Excluir Proposta</h1>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="alert alert-warning" role="alert">
                                            <strong>Atenção!</strong> A exclusão de uma proposta não pode ser desfeita. A proposta será marcada como excluída mas permanecerá nos registros históricos.
                                        </div>

                                        <div class="mb-3">
                                            <label for="deletionReasonText" class="form-label fw-bold">Motivo da Exclusão *</label>
                                            <textarea name="deletion_reason" id="deletionReasonText" class="form-control" rows="4"
                                                      placeholder="Descreva o motivo da exclusão (mínimo 20 caracteres)..." required
                                                      minlength="20"
                                                      maxlength="1000"></textarea>
                                            <div class="form-text">Mínimo de 20 caracteres obrigatório</div>
                                            <small class="d-block mt-2">Caracteres: <span id="charCount">0</span>/1000</small>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" class="btn btn-danger" id="deletionSubmitBtn" disabled>Excluir Proposta</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="tab-content" id="proposalTabsContent">
                        {# Aba: Todas as Propostas #}
                        <div class="tab-pane fade show active" id="panel-all" role="tabpanel" aria-labelledby="tab-all">
                            <table class="js-grid table table-hover table-striped table-sm" style="table-layout: fixed; width: 100%;\">
                                <thead class="table-dark">
                                <tr>
                                    <th class="border-end" style="width: 175px;">ID</th>
                                    <th class="border-end" style="width: 175px;">Região</th>
                                    <th class="border-end" style="width: 175px;">Estado</th>
                                    <th class="border-end" style="width: 175px;">Município</th>
                                    <th class="border-end" style="width: 175px;">Código Município</th>
                                    <th class="border-end" style="width: 175px;">Área de Intervenção</th>
                                    <th class="border-end" style="width: 175px;">Qtd. Domicílios</th>
                                    <th class="border-end" style="width: 175px;">Área Total</th>
                                    <th class="border-end" style="width: 175px;">Valor Global</th>
                                    <th class="border-end" style="width: 175px;">Status</th>
                                    <th class="border-end" style="width: 175px;">Empresa/OSC</th>
                                    <th class="border-end" style="width: 175px;">CNPJ</th>
                                    <th class="border-end" style="width: 175px;">Tipo Instituição</th>
                                    <th class="border-end" style="width: 175px;">Email</th>
                                    <th class="border-end" style="width: 175px;">Telefone</th>
                                    <th class="border-end" style="width: 175px;">Arquivo Poligonal</th>
                                    <th class="border-end" style="width: 175px;">Arquivo Projeto</th>
                                    <th class="border-end" style="width: 175px;">Representante</th>
                                    <th class="border-end" style="width: 175px;">CPF Rep.</th>
                                    <th class="border-end" style="width: 175px;">Email Rep.</th>
                                    <th class="border-end" style="width: 175px;">Telefone Rep.</th>
                                    <th style="width: 175px;">Data Proposta</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for proposal in proposals %}
                                    {% set status = proposal.status ?? '' %}
                                    <tr data-status="{{ status }}" class="proposal-row">
                                        <td class="border-end" style="width: 175px;">{{ proposal.id|slice(0, 8) }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.region }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.state }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.city_name }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.city_code }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.name }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.quantity_houses }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.area_size }}</td>
                                        <td class="border-end" style="width: 175px;">R$ {{ (proposal.quantity_houses * proposal.price_per_house)|number_format(2, ',', '.') }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.status }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_cnpj }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.institution_type }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_email }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_phone }}</td>
                                        <td class="border-end" style="width: 200px; word-break: break-all;">{% if proposal.map_file %}<a href="{{ proposal.map_file }}" target="_blank" class="btn btn-sm" style="background-color: #088140; color: white; font-size: 0.75rem; padding: 0.4rem 0.8rem;"><i class="bi bi-file-earmark"></i> Baixar</a>{% else %}-{% endif %}</td>
                                        <td class="border-end" style="width: 175px; word-break: break-all;">{% if proposal.project_file %}<a href="{{ proposal.project_file }}" target="_blank" class="btn btn-sm btn-info" style="font-size: 0.75rem; padding: 0.4rem 0.8rem;"><i class="bi bi-file-earmark"></i> Baixar</a>{% else %}-{% endif %}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_name|default("-") }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_cpf|default("-") }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_email|default("-") }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_phone|default("-") }}</td>
                                        <td style="width: 175px;">{{ proposal.created_at }}</td>
                                    </tr>
                                {% endfor %}
                                {% if proposals|length == 0 %}
                                    <tr>
                                        <td colspan="21" class="text-center">{{ 'table.no_records_found'|trans }}</td>
                                    </tr>
                                {% endif %}
                                </tbody>
                            </table>
                        </div>

                        {# Aba: Propostas Anuídas #}
                        <div class="tab-pane fade" id="panel-anuida" role="tabpanel" aria-labelledby="tab-anuida">
                            <div class="mb-3">
                                <button class="btn btn-sm btn-secondary" onclick="exportTabaComStatus('{{ statusEnum.ANUIDA.value }}')">
                                    <i class="bi bi-download"></i> Exportar Propostas Anuídas
                                </button>
                            </div>
                            <div class="table-scroll-container">
                            <table class="js-grid table table-hover table-striped table-sm" style="table-layout: fixed; width: 100%;">
                                <thead class="table-dark">
                                <tr>
                                    <th class="border-end" style="width: 175px;">ID</th>
                                    <th class="border-end" style="width: 175px;">Região</th>
                                    <th class="border-end" style="width: 175px;">Estado</th>
                                    <th class="border-end" style="width: 175px;">Município</th>
                                    <th class="border-end" style="width: 175px;">Código Município</th>
                                    <th class="border-end" style="width: 175px;">Área de Intervenção</th>
                                    <th class="border-end" style="width: 175px;">Qtd. Domicílios</th>
                                    <th class="border-end" style="width: 175px;">Área Total</th>
                                    <th class="border-end" style="width: 175px;">Valor Global</th>
                                    <th class="border-end" style="width: 175px;">Status</th>
                                    <th class="border-end" style="width: 175px;">Empresa/OSC</th>
                                    <th class="border-end" style="width: 175px;">CNPJ</th>
                                    <th class="border-end" style="width: 175px;">Tipo Instituição</th>
                                    <th class="border-end" style="width: 175px;">Email</th>
                                    <th class="border-end" style="width: 175px;">Telefone</th>
                                    <th class="border-end" style="width: 175px;">Arquivo Poligonal</th>
                                    <th class="border-end" style="width: 175px;">Arquivo Projeto</th>
                                    <th class="border-end" style="width: 175px;">Representante</th>
                                    <th class="border-end" style="width: 175px;">CPF Rep.</th>
                                    <th class="border-end" style="width: 175px;">Email Rep.</th>
                                    <th class="border-end" style="width: 175px;">Telefone Rep.</th>
                                    <th style="width: 175px;">Data Proposta</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for proposal in proposals %}
                                    {% set status = proposal.status ?? '' %}
                                    {% if status == statusEnum.ANUIDA.value %}
                                    <tr data-status="{{ status }}" class="proposal-row">
                                        <td class="border-end" style="width: 175px;">{{ proposal.id|slice(0, 8) }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.region }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.state }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.city_name }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.city_code }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.name }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.quantity_houses }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.area_size }}</td>
                                        <td class="border-end" style="width: 175px;">R$ {{ (proposal.quantity_houses * proposal.price_per_house)|number_format(2, ',', '.') }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.status }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_cnpj }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.institution_type }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_email }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_phone }}</td>
                                        <td class="border-end" style="width: 200px; word-break: break-all;">{% if proposal.map_file %}<a href="{{ proposal.map_file }}" target="_blank" class="btn btn-sm" style="background-color: #088140; color: white; font-size: 0.75rem; padding: 0.4rem 0.8rem;"><i class="bi bi-file-earmark"></i> Baixar</a>{% else %}-{% endif %}</td>
                                        <td class="border-end" style="width: 175px; word-break: break-all;">{% if proposal.project_file %}<a href="{{ proposal.project_file }}" target="_blank" class="btn btn-sm btn-info" style="font-size: 0.75rem; padding: 0.4rem 0.8rem;"><i class="bi bi-file-earmark"></i> Baixar</a>{% else %}-{% endif %}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_name|default("-") }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_cpf|default("-") }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_email|default("-") }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.representative_phone|default("-") }}</td>
                                        <td style="width: 175px;">{{ proposal.created_at }}</td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                                {% set anuida_count = 0 %}
                                {% for proposal in proposals %}
                                    {% if proposal.status == statusEnum.ANUIDA.value %}
                                        {% set anuida_count = anuida_count + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {% if anuida_count == 0 %}
                                    <tr>
                                        <td colspan="22" class="text-center">{{ 'table.no_records_found'|trans }}</td>
                                    </tr>
                                {% endif %}
                                </tbody>
                            </table>
                            </div>
                        </div>

                        {# Aba: Propostas Selecionadas #}
                        <div class="tab-pane fade" id="panel-selecionada" role="tabpanel" aria-labelledby="tab-selecionada">
                            <div class="mb-3">
                                <button class="btn btn-sm btn-secondary" onclick="exportTabaComStatus('{{ statusEnum.SELECIONADA.value }}')">
                                    <i class="bi bi-download"></i> Exportar Propostas Selecionadas
                                </button>
                            </div>
                            <div class="table-scroll-container">
                            <table class="js-grid table table-hover table-striped table-sm" id="tableSelecionada" style="table-layout: fixed; width: 100%;">
                                <thead class="table-dark">
                                <tr>
                                    <th style="width: 175px;" class="border-end">↕ Posição</th>
                                    <th class="border-end" style="width: 175px;">ID</th>
                                    <th class="border-end" style="width: 175px;">Região</th>
                                    <th class="border-end" style="width: 175px;">Estado</th>
                                    <th class="border-end" style="width: 175px;">Município</th>
                                    <th class="border-end" style="width: 175px;">Código Município</th>
                                    <th class="border-end" style="width: 175px;">Área de Intervenção</th>
                                    <th class="border-end" style="width: 175px;">Qtd. Domicílios</th>
                                    <th class="border-end" style="width: 175px;">Área Total</th>
                                    <th class="border-end" style="width: 175px;">Valor Global</th>
                                    <th class="border-end" style="width: 175px;">Status</th>
                                    <th class="border-end" style="width: 175px;">Empresa/OSC</th>
                                    <th class="border-end" style="width: 175px;">CNPJ</th>
                                    <th class="border-end" style="width: 175px;">Tipo Instituição</th>
                                    <th class="border-end" style="width: 175px;">Email</th>
                                    <th class="border-end" style="width: 175px;">Telefone</th>
                                    <th class="border-end" style="width: 175px;">Arquivo Poligonal</th>
                                    <th class="border-end" style="width: 175px;">Arquivo Projeto</th>
                                    <th class="border-end" style="width: 175px;">Representante</th>
                                    <th class="border-end" style="width: 175px;">CPF Rep.</th>
                                    <th class="border-end" style="width: 175px;">Email Rep.</th>
                                    <th class="border-end" style="width: 175px;">Telefone Rep.</th>
                                    <th style="width: 175px;">Data Proposta</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for proposal in proposals %}
                                    {% set status = proposal.status ?? '' %}
                                    {% if status == statusEnum.SELECIONADA.value %}
                                    <tr data-status="{{ status }}" class="proposal-row sortable-item" data-proposal-id="{{ proposal.id }}" {% if is_granted('ROLE_ADMIN') %}draggable="true"{% endif %} data-current-order="{{ proposal.order ?? '' }}">
                                        <td style="cursor: {% if is_granted('ROLE_ADMIN') %}move{% else %}default{% endif %}; font-weight: bold; text-align: center; width: 60px;" class="border-end">
                                            <input type="number" class="form-control form-control-sm position-input-sel" value="{{ proposal.order ?? '' }}" min="1" style="width: 175px;" {% if not is_granted('ROLE_ADMIN') %}disabled{% endif %}>
                                        </td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.id|slice(0, 8) }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.region }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.state }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.city_name }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.city_code }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.name }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.quantity_houses }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.area_size }}</td>
                                        <td class="border-end" style="width: 175px;">R$ {{ (proposal.quantity_houses * proposal.price_per_house)|number_format(2, ',', '.') }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.status }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_cnpj }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.institution_type }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_email }}</td>
                                        <td class="border-end" style="width: 175px;">{{ proposal.company_phone }}</td>
                                        <td class="border-end" style="width: 200px; word-break: break-all;">
                                            {% if proposal.map_file %}<a href="{{ proposal.map_file }}" target="_blank" class="btn btn-sm" style="background-color: #088140; color: white; font-size: 0.75rem; padding: 0.4rem 0.8rem;"><i class="bi bi-file-earmark"></i> Baixar</a>
