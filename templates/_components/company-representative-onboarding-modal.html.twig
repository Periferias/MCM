{% if app.user and 'ROLE_COMPANY' in app.user.roles %}
<!-- Company Representative Onboarding Modal -->
<div class="modal fade" id="companyRepresentativeOnboardingModal" tabindex="-1" aria-labelledby="companyRepresentativeOnboardingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 80vw;">
        <div class="modal-content">
            <div class="modal-body text-center p-4">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                
                <!-- Image showing the company process flow -->
                <div class="onboarding-image-container mb-4">
                    <img 
                        src="{{ asset('img/modal-processo.png') }}" 
                        alt="{{ 'view.company.onboarding.flow_description' | trans }}"
                        class="img-fluid rounded"
                    >
                </div>

                <div class="alert alert-info" role="alert">
                    <p class="mb-0">
                        {{ 'view.company.onboarding.info_message' | trans }}
                    </p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                    {{ 'view.company.onboarding.button_understand' | trans }}
                </button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="{{ asset('js/company-representative-onboarding-modal.js') }}"></script>
{% endif %}
